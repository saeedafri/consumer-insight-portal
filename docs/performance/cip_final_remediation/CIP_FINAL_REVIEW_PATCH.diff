+        )
+        conn.execute(
+            text(
+                """
+                INSERT INTO cip_profile (respondent_id, survey_id, generation)
+                VALUES (:respondent_id, :survey_id, :generation)
+                """
+            ),
+            respondents,
+        )
+
+        answers = []
+
+        def answer(respondent_id: int, survey_id: int, field_id: int, code: int) -> None:
+            answers.append(
+                {
+                    "respondent_id": respondent_id,
+                    "survey_id": survey_id,
+                    "field_id": field_id,
+                    "value_code": code,
+                }
