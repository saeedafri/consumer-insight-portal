{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cip-dwh",
      "runtimeExecutable": ".venv/bin/streamlit",
      "runtimeArgs": ["run", "app/main.py", "--server.port", "8502"],
      "port": 8502
    },
    {
      "name": "cip-local",
      "runtimeExecutable": "env",
