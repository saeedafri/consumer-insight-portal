  "cards": [
    {
      "dot": "cyan",
      "title": "What each flow carries",
      "items": [
        "API pull / xlsx load: datamap (questions, options, rows) + one record per respondent",
        "questions -> csi_survey, csi_topic, csi_question, csi_item, csi_option, csi_field",
        "answers -> csi_respondent, csi_profile, csi_answer (long format)",
        "cells -> csi_banner, csi_segment, csi_crosstab_run, csi_crosstab with the true answering base"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why long format",
      "items": [
        "One row per respondent x export column in csi_answer",
        "A new module (Beauty, Tariffs) is new rows, never a migration",
        "09/21 had 375 columns, 09/28 has 519 \u2014 same schema"
      ]
    },
    {
      "dot": "amber",
      "title": "Wave identity",
      "items": [
        "One Forsta project is re-fielded weekly with rotating modules",
        "csi_survey is keyed on host + path + wave_label",
        "Trends join waves by survey_family and question code"
      ]
    },
    {
      "dot": "rose",
      "title": "Blocked today",
      "items": [
        "Forsta key exists but its API user is disabled (401)",
        "Excel bridge loads the same tables until IT re-enables it",
        "Portal reads through views; ETL is the only writer",
        "Every run writes csi_load_log / csi_load_error for lineage"
      ]
    }
  ]
