{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "esnext"], "strict": true, "noEmit": true, "module": "esnext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "isolatedModules": true, "skipLibCheck": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["app", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "static"]
}
