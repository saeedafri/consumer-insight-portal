# ══════════════════════════════════════════════════════════════════════════
# Consumer Insight Portal — environment template
# Copy to .env and fill in. NEVER commit .env.
# ══════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────
APP_ENV=STAGING                 # LOCAL | STAGING | PRODUCTION
DEBUG=0
# Local testing without sign-in: APP_ENV=LOCAL + DEBUG=true (the MDP gate).
# The portal then acts as this user against dwh_stg. Inactive on STG/PROD.
LOCAL_TEST_USER_EMAIL=
PYTHONDONTWRITEBYTECODE=1

# ── STG (DWH) MySQL — ask IT/DBA for these ────────────────────────────────
STG_DB_HOST=
STG_DB_PORT=3306
STG_DB_NAME=dwh_stg
STG_DB_USER=                    # csi_etl  (write) — used by etl/
STG_DB_PASSWORD=
STG_DB_SSL_CA=DigiCertGlobalRootG2.crt.pem
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Read-only account used by the Streamlit app (least privilege)
APP_DB_USER=                    # csi_app (SELECT only)
APP_DB_PASSWORD=

# ── Local MySQL — optional. Set LOCAL_DB_HOST only if you run one: with it,
#    APP_ENV=LOCAL uses it; without it, APP_ENV=LOCAL uses the STG_DB_* database.
# LOCAL_DB_HOST=127.0.0.1
# LOCAL_DB_PORT=3306
# LOCAL_DB_NAME=csi_local
# LOCAL_DB_USER=root
# LOCAL_DB_PASSWORD=

# ── Forsta Surveys (Decipher) API — ask IT / Forsta admin for these ───────
FORSTA_HOST=se1.decipherinc.com         # confirmed from the survey URL
FORSTA_API_KEY=                          # 64-char key, sent as `x-apikey`
FORSTA_SURVEY_PATH=selfserve/58f/260908  # confirmed from the survey URL
FORSTA_DATA_LAYOUT_ID=                   # optional: custom data layout
FORSTA_REPORT_PATH=                      # optional: crosstab/table-set name
FORSTA_DATAFEED_NAME=                    # optional: incremental datafeed
FORSTA_TIMEOUT_SECONDS=120
FORSTA_MAX_RETRIES=4

# ── Ingestion behaviour ───────────────────────────────────────────────────
INGEST_COND=qualified           # Forsta filter expression for the data pull
INGEST_BATCH_SIZE=2000

# ── Local development without VPN access to STG ───────────────────────────
# Set APP_ENV=LOCAL and point this at a file; the MySQL schema is converted
# to SQLite automatically (app/core/sqlite_compat.py). Same code, same SQL.
LOCAL_SQLITE_PATH=data/csi_local.db

# ── Access control (see docs/08-authentication.md) ────────────────────────
# local  = email allowlist + shared passphrase (works today, no IdP)
# oidc   = Coresight SSO; also set IDP_BASE_URL / IDP_TOKEN_URL /
#          IDP_USERINFO_URL / OIDC_CLIENT_ID / OIDC_CLIENT_SECRET
# off    = no login; refuses to run outside APP_ENV=LOCAL
AUTH_PROVIDER=local
AUTH_ALLOWED_EMAILS=@coresight.com
AUTH_SHARED_PASSPHRASE=
AUTH_SESSION_HOURS=12
